---
import "../style.scss";
import Topbars from "../lib/Topbars.tsx";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>React pureUI</title>
	</head>
	<body>
		<Topbars client:only="react" />

		<script type="module">
			let button = document.querySelector(".theme-switch");
			button.addEventListener("click", () => {
				if (document.querySelectorAll(".dark").length > 0) {
					document.querySelectorAll("main").forEach((e) => {e.classList.remove("dark"); e.classList.add("light")});
				} else {
					document.querySelectorAll("main").forEach((e) => {e.classList.add("dark"); e.classList.remove("light")});
				}
			});
		</script>
	</body>
</html>
